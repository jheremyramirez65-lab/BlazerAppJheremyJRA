<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="container mt-5">
                            <div class="alert alert-warning" role="alert">
                                <h4 class="alert-heading">Sin permisos</h4>
                                <p class="mb-2">Tu cuenta no tiene acceso a esta sección.</p>
                                <a href="panel" class="btn btn-sm btn-outline-secondary">Volver al panel</a>
                            </div>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <p class="p-4 text-muted">Verificando sesión...</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>