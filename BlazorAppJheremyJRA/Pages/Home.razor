@page "/"
@attribute [Authorize]
<PageTitle>Home</PageTitle>

<div class="container mt-5">

    <!-- Logo de perfil -->
    <div class="text-center mb-4">

        <img src="imagenes/snoopy.jpg"
             width="150"
             height="150"
             class="rounded-circle shadow"
             style="object-fit: cover;" />

    </div>


    <!-- Título -->
    <div class="text-center mb-5">

        <h1 class="display-4">
            Bienvenido a Biblioteca Virtual
        </h1>

        <p class="lead">
            Sistema de registro de libros y autores
        </p>

    </div>


    <!-- Redes sociales -->
    <div class="row justify-content-center">


        <!-- WhatsApp -->
        <div class="col-md-4 mb-4">

            <div class="card shadow text-center h-100">

                <div class="card-body">

                    <img src="imagenes/logow.jpg"
                         width="100"
                         height="100"
                         class="mb-3"
                         style="object-fit: contain;" />

                    <h3>
                        WhatsApp
                    </h3>

                    <p>
                        Comunícate con nosotros por WhatsApp
                    </p>

                    <a href="https://wa.me/59170000000"
                       target="_blank"
                       class="btn btn-success">

                        Abrir WhatsApp

                    </a>

                </div>

            </div>

        </div>


        <!-- Facebook -->
        <div class="col-md-4 mb-4">

            <div class="card shadow text-center h-100">

                <div class="card-body">

                    <img src="imagenes/logof.png"
                         width="100"
                         height="100"
                         class="mb-3"
                         style="object-fit: contain;" />

                    <h3>
                        Facebook
                    </h3>

                    <p>
                        Síguenos en nuestra página de Facebook
                    </p>

                    <a href="https://facebook.com"
                       target="_blank"
                       class="btn btn-primary">

                        Visitar Facebook

                    </a>

                </div>

            </div>

        </div>


    </div>


</div>