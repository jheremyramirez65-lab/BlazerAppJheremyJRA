@page "/restablecer"
@layout AuthLayout
@inject AuthService Auth
@using BlazorAppJheremyJRA.Services

<PageTitle>Restablecer contraseña</PageTitle>

<div class="auth-card">

    <div class="text-center mb-4">
        <h2 class="auth-title">Nueva contraseña</h2>
        <p class="text-muted mb-0">Elige una contraseña segura</p>
    </div>

    @if (string.IsNullOrEmpty(Token))
    {
        <div class="alert alert-danger" role="alert">
            El enlace no es válido. <a href="olvide-password">Solicita uno nuevo</a>.
        </div>
    }
    else if (listo)
    {
        <div class="alert alert-success" role="alert">@mensaje</div>
        <a href="login" class="btn btn-primary w-100">Ir a iniciar sesión</a>
    }
    else
    {
        <EditForm Model="modelo" OnValidSubmit="Guardar" novalidate>
            <DataAnnotationsValidator />

            <fieldset disabled="@cargando" class="border-0 p-0 m-0">
                <div class="mb-3">
                    <label for="password" class="form-label">Nueva contraseña</label>
                    <InputText id="password" type="password" class="form-control" autocomplete="new-password"
                               @bind-Value="modelo.Password" />
                    <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
                    <ValidationMessage For="() => modelo.Password" />
                </div>

                <div class="mb-3">
                    <label for="confirmar" class="form-label">Confirmar contraseña</label>
                    <InputText id="confirmar" type="password" class="form-control" autocomplete="new-password"
                               @bind-Value="modelo.ConfirmarPassword" />
                    <ValidationMessage For="() => modelo.ConfirmarPassword" />
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger py-2" role="alert">@mensajeError</div>
                }

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    @(cargando ? "Guardando..." : "Cambiar contraseña")
                </button>
            </fieldset>
        </EditForm>
    }

</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly RestablecerPasswordCLS modelo = new();
    private bool cargando;
    private bool listo;
    private string mensaje = "";
    private string mensajeError = "";

    private async Task Guardar()
    {
        if (cargando || string.IsNullOrEmpty(Token)) return;

        cargando = true;
        mensajeError = "";

        try
        {
            modelo.Token = Token;
            var (ok, texto) = await Auth.RestablecerPasswordAsync(modelo);

            if (ok)
            {
                listo = true;
                mensaje = texto;
            }
            else
            {
                mensajeError = texto;
            }
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error inesperado. Inténtalo de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }
}