@page "/LibroFormPage/{idLibro:int}"

@using BlazorAppJheremyJRA.Entities
@using BlazorAppJheremyJRA.Services
@using BlazorAppJheremyJRA.Components.Libro

@inject LibroService libroService
@inject NavigationManager navigationManager
@inject IJSRuntime JS


<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">
                <i class="bi bi-book"></i>
                Datos del Libro
            </h4>
        </div>


        <div class="card-body">

            <FormLibro @ref="formLibro"
                       idLibro="idLibro"
                       GuardarClick="Guardar" />


            <div class="mt-3">

                <button type="button"
                        class="btn btn-primary me-2"
                        @onclick="Nuevo">

                    Nuevo Libro

                </button>


                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Limpiar">

                    Limpiar

                </button>

            </div>

        </div>

    </div>

</div>


<div class="container mt-4">

    @if (listaLibros.Count > 0)
    {
        <div class="card shadow">

            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">
                    <i class="bi bi-book-half"></i>
                    Libros Registrados
                </h4>
            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th>ID</th>
                                <th>Código</th>
                                <th>Imagen</th>
                                <th>Título</th>
                                <th>Autor</th>
                                <th>Editorial</th>
                                <th>Año</th>
                                <th>Páginas</th>
                                <th>Stock</th>
                                <th>Categoría</th>
                                <th>Tipo de Libro</th>
                                <th>Nombre archivo</th>
                                <th>Acciones</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var libro in listaLibros)
                            {
                                <tr>

                                    <td>
                                        @libro.idLibro
                                    </td>

                                    <td>
                                        @libro.codigo
                                    </td>

                                    <td>

                                        <img src="@libro.Imagen"
                                             width="60"
                                             height="60"
                                             class="img-thumbnail" />

                                    </td>

                                    <td>
                                        <strong>
                                            @libro.titulo
                                        </strong>
                                    </td>

                                    <td>
                                        @libro.autor
                                    </td>

                                    <td>
                                        @libro.editorial
                                    </td>

                                    <td>
                                        @libro.anio
                                    </td>

                                    <td>
                                        @libro.numeroPaginas
                                    </td>

                                    <td>
                                        @libro.stock
                                    </td>

                                    <td>
                                        @libro.categoria
                                    </td>

                                    <td>
                                        @libro.nombretipolibro
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrEmpty(libro.nombrearchivo))
                                        {
                                            <a href="#"
                                               @onclick="() => DescargarArchivo(libro.idLibro, libro.nombrearchivo!)"
                                               @onclick:preventDefault="true"
                                               style="cursor:pointer; text-decoration:underline;">

                                                @libro.nombrearchivo

                                            </a>
                                        }
                                        else
                                        {
                                            <span>
                                                Sin archivo
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <button class="btn btn-warning btn-sm me-1"
                                                @onclick="() => Editar(libro.idLibro)">

                                            Editar

                                        </button>


                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => Eliminar(libro.idLibro)">

                                            Eliminar

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay libros registrados.
        </div>
    }

</div>


@code {

    [Parameter]
    public int idLibro { get; set; }


    private FormLibro? formLibro;

    private List<LibroListCLS> listaLibros = new();


    protected override async Task OnParametersSetAsync()
    {
        listaLibros =
            await libroService.listarLibros();
    }


    private async Task Guardar(
        LibroFormCLS formulario)
    {
        if (idLibro == 0)
        {
            await libroService.guardarLibro(formulario);
        }
        else
        {
            await libroService.actualizarLibro(formulario);
        }


        listaLibros =
            await libroService.listarLibros();


        navigationManager.NavigateTo(
            "/LibroFormPage/0"
        );
    }


    private void Editar(int id)
    {
        navigationManager.NavigateTo(
            $"/LibroFormPage/{id}"
        );
    }


    private async Task Eliminar(int id)
    {
        await libroService.eliminarLibro(id);

        listaLibros =
            await libroService.listarLibros();
    }


    private void Nuevo()
    {
        navigationManager.NavigateTo(
            "/LibroFormPage/0"
        );
    }


    private async Task Limpiar()
    {
        if (formLibro != null)
        {
            await formLibro.LimpiarFormulario();
        }
    }

    private async Task DescargarArchivo(int id, string nombreArchivo)
    {
        string base64 = await libroService.recuperarArchivoPorId(id);

        if (!string.IsNullOrEmpty(base64))
        {
            await JS.InvokeVoidAsync(
                "descargarArchivo",
                nombreArchivo,
                base64
            );
        }
    }

}