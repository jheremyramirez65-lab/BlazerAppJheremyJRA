@page "/AutorForm"
@page "/AutorForm/{idAutor:int}"

@using BlazorAppJheremyJRA.Entities
@using BlazorAppJheremyJRA.Services
@using BlazorAppJheremyJRA.Components.Autor

@inject AutorService autorService
@inject NavigationManager navigationManager
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3 container mt-4">

    <h3>Registro de Autor</h3>

    <img src="imagenes/logo.jpg"
         width="90"
         height="90"
         style="object-fit:contain;" />

</div>

<div class="container mt-2">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Datos del Autor</h4>
        </div>

        <div class="card-body">

            <FormAutor @ref="formAutor"
                       idAutor="idAutor"
                       GuardarClick="Guardar" />

            <div class="mt-3">

                <button type="button"
                        class="btn btn-primary me-2"
                        @onclick="Nuevo">
                    Nuevo Autor
                </button>

                <button type="button"
                        class="btn btn-secondary me-2"
                        @onclick="Limpiar">
                    Limpiar
                </button>

                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="Regresar">
                    Regresar
                </button>

            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-success mt-3">
                    @mensaje
                </div>
            }

        </div>

    </div>

</div>

<div class="container mt-4">

    @if (listaAutores.Count > 0)
    {
        <div class="card shadow">

            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Autores Registrados</h4>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Imagen</th>
                                <th>Nombre</th>
                                <th>Ap. Paterno</th>
                                <th>Ap. Materno</th>
                                <th>Sexo</th>
                                <th>País</th>
                                <th>Descripción</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var autor in listaAutores)
                            {
                                <tr>

                                    <td>@autor.idAutor</td>

                                    <td class="text-center">
                                        <img src="@autor.imagen"
                                             width="60"
                                             height="60"
                                             class="rounded-circle"
                                             style="object-fit:cover;" />
                                    </td>

                                    <td><strong>@autor.nombre</strong></td>

                                    <td>@autor.apPaterno</td>

                                    <td>@autor.apMaterno</td>

                                    <td>@autor.nombreSexo</td>

                                    <td>@autor.nombrePais</td>

                                    <td>@autor.descripcion</td>

                                    <td class="text-center">

                                        <button class="btn btn-warning btn-sm me-1"
                                                @onclick="() => Editar(autor.idAutor)">
                                            Editar
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => Eliminar(autor.idAutor)">
                                            Eliminar
                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay autores registrados.
        </div>
    }

</div>

@code {

    [Parameter]
    public int idAutor { get; set; }

    private FormAutor? formAutor;

    private List<AutorListCLS> listaAutores = new();

    private string mensaje = "";

    protected override async Task OnParametersSetAsync()
    {
        listaAutores = await autorService.listarAutores();
    }

    private async Task Guardar(AutorFormCLS formulario)
    {
        if (idAutor == 0)
        {
            await autorService.guardarAutor(formulario);

            mensaje = "El autor se ha guardado correctamente.";

            listaAutores = await autorService.listarAutores();

            if (formAutor != null)
            {
                await formAutor.LimpiarFormulario();
            }
        }
        else
        {
            await autorService.actualizarAutor(formulario);

            mensaje = "El autor se ha actualizado correctamente.";

            listaAutores = await autorService.listarAutores();

            navigationManager.NavigateTo("/AutorForm/0");
        }
    }

    private void Editar(int id)
    {
        mensaje = "";

        navigationManager.NavigateTo($"/AutorForm/{id}");
    }

    private async Task Eliminar(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Está seguro que desea eliminar este autor?");

        if (!confirmar)
            return;

        await autorService.eliminarAutor(id);

        listaAutores = await autorService.listarAutores();

        mensaje = "Autor eliminado correctamente.";
    }

    private void Nuevo()
    {
        mensaje = "";

        navigationManager.NavigateTo("/AutorForm/0");
    }

    private async Task Limpiar()
    {
        mensaje = "";

        if (formAutor != null)
        {
            await formAutor.LimpiarFormulario();
        }
    }

    private void Regresar()
    {
        navigationManager.NavigateTo("/autores");
    }
}