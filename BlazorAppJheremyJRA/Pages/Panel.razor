@page "/panel"
@attribute [Authorize]
<h3>Panel Principal</h3>

<div class="container mt-4">

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h5>Usuarios</h5>
                <p>Gestión de usuarios del sistema.</p>

                <a href="/usuarios"
                   class="btn btn-primary">
                    Ver usuarios
                </a>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h5>Reportes</h5>
                <p>Consultar reportes del sistema.</p>

                <button class="btn btn-primary">
                    Ver reportes
                </button>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h5>Configuración</h5>
                <p>Configuración del sistema.</p>

                <button class="btn btn-primary">
                    Configuración
                </button>
            </div>
        </div>

    </div>

</div>