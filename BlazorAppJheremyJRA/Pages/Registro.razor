@page "/registro"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Navigation
@using BlazorAppJheremyJRA.Services

<PageTitle>Crear cuenta</PageTitle>

<div class="auth-card">

    <div class="text-center mb-4">
        <h2 class="auth-title">Crear una cuenta</h2>
        <p class="text-muted mb-0">Completa tus datos para registrarte</p>
    </div>

    <EditForm Model="modelo" OnValidSubmit="Registrar" novalidate>

        <DataAnnotationsValidator />

        <fieldset disabled="@cargando" class="border-0 p-0 m-0">

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="nombre" class="form-label">Nombre</label>
                    <InputText id="nombre" class="form-control" autocomplete="given-name"
                               @bind-Value="modelo.Nombre" />
                    <ValidationMessage For="() => modelo.Nombre" />
                </div>
                <div class="col-6">
                    <label for="apellido" class="form-label">Apellido</label>
                    <InputText id="apellido" class="form-control" autocomplete="family-name"
                               @bind-Value="modelo.Apellido" />
                    <ValidationMessage For="() => modelo.Apellido" />
                </div>
            </div>

            <div class="mb-3">
                <label for="usuario" class="form-label">Nombre de usuario</label>
                <InputText id="usuario" class="form-control" autocomplete="username"
                           @bind-Value="modelo.NombreUsuario" />
                <ValidationMessage For="() => modelo.NombreUsuario" />
            </div>

            <div class="mb-3">
                <label for="correo" class="form-label">Correo electrónico</label>
                <InputText id="correo" type="email" class="form-control" autocomplete="email"
                           @bind-Value="modelo.Correo" />
                <ValidationMessage For="() => modelo.Correo" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Contraseña</label>
                <InputText id="password" type="password" class="form-control" autocomplete="new-password"
                           @bind-Value="modelo.Password" />
                <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
                <ValidationMessage For="() => modelo.Password" />
            </div>

            <div class="mb-3">
                <label for="confirmar" class="form-label">Confirmar contraseña</label>
                <InputText id="confirmar" type="password" class="form-control" autocomplete="new-password"
                           @bind-Value="modelo.ConfirmarPassword" />
                <ValidationMessage For="() => modelo.ConfirmarPassword" />
            </div>

            <div aria-live="polite">
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger py-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @mensajeError
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Creando cuenta...</span>
                }
                else
                {
                    <span>Registrarse</span>
                }
            </button>

        </fieldset>

    </EditForm>

    <div class="text-center mt-4">
        <span class="text-muted">¿Ya tienes cuenta?</span>
        <a href="login">Iniciar sesión</a>
    </div>

</div>

@code {
    private readonly RegistroRequestCLS modelo = new();
    private bool cargando;
    private string mensajeError = "";

    private async Task Registrar()
    {
        if (cargando) return;

        cargando = true;
        mensajeError = "";

        try
        {
            modelo.Nombre = modelo.Nombre.Trim();
            modelo.Apellido = modelo.Apellido.Trim();
            modelo.NombreUsuario = modelo.NombreUsuario.Trim();
            modelo.Correo = modelo.Correo.Trim();

            var (ok, error) = await Auth.RegistroAsync(modelo);

            if (ok)
            {
                Navigation.NavigateTo("panel", replace: true);
                return;
            }

            mensajeError = error ?? "No se pudo crear la cuenta.";
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error inesperado. Inténtalo de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }
}