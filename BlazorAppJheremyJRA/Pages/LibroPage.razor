@page "/libro"

@using BlazorAppJheremyJRA.Components.Libro

@inject NavigationManager navigationManager


<h3>Libros</h3>


<div class="mt-3 mb-3">

    <button @onclick="nuevo"
            class="btn btn-primary">

        Nuevo

    </button>

</div>


<SearchLibro BuscarClick="Filtrar" />

<ListLibro @ref="listaLibro" />


@code {

    private void nuevo()
    {
        navigationManager.NavigateTo(
            "/LibroFormPage/0"
        );
    }

    private ListLibro? listaLibro;


    private async Task Filtrar(string titulo)
    {
        if (listaLibro != null)
        {
            await listaLibro.filtrar(titulo);
        }
    }

}