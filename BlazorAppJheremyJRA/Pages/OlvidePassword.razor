@page "/olvide-password"
@layout AuthLayout
@inject AuthService Auth
@using BlazorAppJheremyJRA.Services

<PageTitle>Recuperar contraseña</PageTitle>

<div class="auth-card">

    <div class="text-center mb-4">
        <h2 class="auth-title">¿Olvidaste tu contraseña?</h2>
        <p class="text-muted mb-0">Ingresa tu correo para generar un enlace de recuperación</p>
    </div>

    @if (enviado)
    {
        <div class="alert alert-success" role="alert">@mensaje</div>

        @if (!string.IsNullOrEmpty(enlace))
        {
            <div class="alert alert-warning small">
                <strong>Modo desarrollo:</strong> como no hay servidor de correo,
                usa este enlace:<br />
                <a href="@enlace">Restablecer mi contraseña</a>
            </div>
        }
    }
    else
    {
        <EditForm Model="modelo" OnValidSubmit="Enviar" novalidate>
            <DataAnnotationsValidator />

            <fieldset disabled="@cargando" class="border-0 p-0 m-0">
                <div class="mb-3">
                    <label for="correo" class="form-label">Correo electrónico</label>
                    <InputText id="correo" type="email" class="form-control form-control-lg"
                               placeholder="tucorreo@ejemplo.com" @bind-Value="modelo.Correo" />
                    <ValidationMessage For="() => modelo.Correo" />
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger py-2" role="alert">@mensajeError</div>
                }

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    @(cargando ? "Enviando..." : "Generar enlace")
                </button>
            </fieldset>
        </EditForm>
    }

    <div class="text-center mt-4">
        <a href="login">Volver a iniciar sesión</a>
    </div>

</div>

@code {
    private readonly OlvidePasswordCLS modelo = new();
    private bool cargando;
    private bool enviado;
    private string mensaje = "";
    private string mensajeError = "";
    private string? enlace;

    private async Task Enviar()
    {
        if (cargando) return;

        cargando = true;
        mensajeError = "";

        try
        {
            modelo.Correo = modelo.Correo.Trim();
            var (ok, texto, enlaceDev) = await Auth.OlvidePasswordAsync(modelo);

            if (ok)
            {
                enviado = true;
                mensaje = texto;
                enlace = enlaceDev;
            }
            else
            {
                mensajeError = texto;
            }
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error inesperado. Inténtalo de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }
}