@page "/admin/usuarios"
@attribute [Authorize(Policy = Politicas.AdministrarUsuarios)]
@using Microsoft.AspNetCore.Authorization
@using BlazorAppJheremyJRA.Services
@inject UsuarioAdminService Servicio

<PageTitle>Gestión de usuarios</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Gestión de usuarios</h1>
    <button class="btn btn-primary" @onclick="Nuevo">
        <i class="bi bi-person-plus-fill me-1"></i> Nuevo usuario
    </button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(mensajeOk ? "alert-success" : "alert-danger") py-2" role="alert">@mensaje</div>
}

@if (mostrarForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(form.Id == 0 ? "Nuevo usuario" : "Editar usuario")</h5>

            <EditForm Model="form" OnValidSubmit="Guardar" novalidate>
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="form.Nombre" />
                        <ValidationMessage For="() => form.Nombre" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellido</label>
                        <InputText class="form-control" @bind-Value="form.Apellido" />
                        <ValidationMessage For="() => form.Apellido" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nombre de usuario</label>
                        <InputText class="form-control" @bind-Value="form.NombreUsuario" />
                        <ValidationMessage For="() => form.NombreUsuario" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo</label>
                        <InputText type="email" class="form-control" @bind-Value="form.Correo" />
                        <ValidationMessage For="() => form.Correo" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Rol</label>
                        <InputSelect class="form-select" @bind-Value="form.IdRol">
                            <option value="0">Selecciona un rol...</option>
                            @foreach (var rol in roles)
                            {
                                <option value="@rol.Id">@rol.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => form.IdRol" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            Contraseña @(form.Id != 0 ? "(vacía = no cambiar)" : "")
                        </label>
                        <InputText type="password" class="form-control" autocomplete="new-password"
                                   @bind-Value="form.Password" />
                        <ValidationMessage For="() => form.Password" />
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-12 col-md-5">
        <input class="form-control" placeholder="Buscar usuario..."
               @bind="buscar" @bind:event="oninput" @onkeydown="TeclaBuscar" />
    </div>
    <div class="col-6 col-md-3">
        <select class="form-select" @bind="idRolFiltro" @bind:after="Cargar">
            <option value="">Todos los roles</option>
            @foreach (var rol in roles)
            {
                <option value="@rol.Id">@rol.Nombre</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select class="form-select" @bind="estadoFiltro" @bind:after="Cargar">
            <option value="">Todos</option>
            <option value="activo">Activos</option>
            <option value="inactivo">Inactivos</option>
        </select>
    </div>
    <div class="col-12 col-md-2">
        <button class="btn btn-outline-primary w-100" @onclick="Cargar">Buscar</button>
    </div>
</div>

@if (cargando)
{
    <p class="text-muted">Cargando...</p>
}
else if (usuarios.Count == 0)
{
    <p class="text-muted">No se encontraron usuarios.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in usuarios)
                {
                    <tr>
                        <td>@u.NombreUsuario</td>
                        <td>@u.Nombre @u.Apellido</td>
                        <td>@u.Correo</td>
                        <td><span class="badge bg-secondary">@u.Rol</span></td>
                        <td>
                            <span class="badge @(u.Habilitado ? "bg-success" : "bg-danger")">
                                @(u.Habilitado ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end">
                            @if (idConfirmar == u.Id)
                            {
                                <span class="me-2">¿@(u.Habilitado ? "Desactivar" : "Activar")?</span>
                                <button class="btn btn-sm btn-danger" @onclick="() => CambiarEstado(u)">Sí</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => idConfirmar = 0">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Editar(u)">Editar</button>
                                <button class="btn btn-sm @(u.Habilitado ? "btn-outline-danger" : "btn-outline-success")"
                                        @onclick="() => idConfirmar = u.Id">
                                    @(u.Habilitado ? "Desactivar" : "Activar")
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<UsuarioAdminCLS> usuarios = new();
    private List<RolCLS> roles = new();
    private UsuarioFormCLS form = new();

    private string buscar = "";
    private int? idRolFiltro;
    private string estadoFiltro = "";

    private bool cargando = true;
    private bool guardando;
    private bool mostrarForm;
    private int idConfirmar;

    private string mensaje = "";
    private bool mensajeOk;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            roles = await Servicio.ListarRolesAsync();
        }
        catch (HttpRequestException)
        {
            Avisar("No se pudieron cargar los roles.", false);
        }

        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        idConfirmar = 0;

        try
        {
            usuarios = await Servicio.ListarAsync(buscar, idRolFiltro, estadoFiltro);
        }
        catch (HttpRequestException)
        {
            usuarios = new();
            Avisar("No se pudo cargar la lista de usuarios. Verifica que la API esté en ejecución.", false);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task TeclaBuscar(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Cargar();
    }

    private void Nuevo()
    {
        form = new UsuarioFormCLS();
        mostrarForm = true;
        mensaje = "";
    }

    private void Editar(UsuarioAdminCLS u)
    {
        form = new UsuarioFormCLS
        {
            Id = u.Id,
            Nombre = u.Nombre,
            Apellido = u.Apellido,
            NombreUsuario = u.NombreUsuario,
            Correo = u.Correo,
            IdRol = u.IdRol
        };
        mostrarForm = true;
        mensaje = "";
    }

    private void Cancelar() => mostrarForm = false;

    private async Task Guardar()
    {
        if (guardando) return;

        guardando = true;

        try
        {
            var (ok, texto) = await Servicio.GuardarAsync(form);
            Avisar(texto, ok);

            if (ok)
            {
                mostrarForm = false;
                await Cargar();
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CambiarEstado(UsuarioAdminCLS u)
    {
        var (ok, texto) = await Servicio.CambiarEstadoAsync(u.Id, !u.Habilitado);
        Avisar(texto, ok);
        idConfirmar = 0;

        if (ok) await Cargar();
    }

    private void Avisar(string texto, bool ok)
    {
        mensaje = texto;
        mensajeOk = ok;
    }
}